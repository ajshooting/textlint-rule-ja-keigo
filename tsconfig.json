{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "strict": true,
        "esModuleInterop": true,
        "outDir": "dist",
        "declaration": true,
        "isolatedModules": true,
        "typeRoots": ["./node_modules/@types", "./types", "./src/types"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
}
